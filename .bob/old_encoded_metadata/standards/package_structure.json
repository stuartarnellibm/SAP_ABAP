{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SAP R/3 Package Structure - CPG Implementation",
  "description": "Package organization and structure for CPG Order-to-Cash and Warehouse Management",
  "last_updated": "2026-06-17",
  "system": "SAP R/3 ECC 6.0 On-Premise",
  
  "package_hierarchy": {
    "root_package": {
      "name": "ZCPG",
      "description": "CPG Root Package",
      "package_type": "Development",
      "transport_layer": "ZCPG",
      "software_component": "HOME",
      "responsible": "CPG Development Team",
      "purpose": "Container for all CPG custom developments"
    },
    
