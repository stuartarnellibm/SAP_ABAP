        "description": "Sales & Distribution",
        "parent": "ZCPG",
        "responsible": "SD Development Team",
        "purpose": "Order-to-Cash process developments",
        "object_types": [
          "Programs (ZCPG_SD_*)",
          "Function Groups (ZCPG_SD_*)",
          "Classes (ZCL_CPG_SD_*)",
          "Tables (ZCPG_SD_*)",
          "Interfaces (ZIF_CPG_SD_*)",
          "Exceptions (ZCX_CPG_SD_*)"
        ],
        "sub_packages": [
          {
            "name": "ZCPG_SD_ORDER",
            "description": "Order Management",
            "objects": [
              "Order creation and modification",
              "Order validation",
              "Order monitoring",
              "Order reports"
            ]
          },
          {
            "name": "ZCPG_SD_PRICING",
            "description": "Pricing and Promotions",
