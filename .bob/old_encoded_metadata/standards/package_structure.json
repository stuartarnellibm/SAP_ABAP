  "package_assignment_rules": {
    "general_rules": [
      "All custom objects must be in Z packages",
      "Use appropriate module package based on functionality",
      "Use sub-packages for logical grouping",
      "Set correct transport layer (ZCPG)",
      "Assign to HOME software component"
    ],
    
    "decision_tree": {
      "question_1": "Is it order-to-cash related?",
      "yes": "Use ZCPG_SD or sub-packages",
      "no": "Continue to question 2",
      
      "question_2": "Is it material/inventory related?",
      "yes": "Use ZCPG_MM or sub-packages",
      "no": "Continue to question 3",
      
      "question_3": "Is it warehouse operations related?",
      "yes": "Use ZCPG_WM or sub-packages",
      "no": "Continue to question 4",
      
      "question_4": "Is it delivery/shipping related?",
      "yes": "Use ZCPG_LE or sub-packages",
      "no": "Continue to question 5",
      
      "question_5": "Is it a common utility?",
      "yes": "Use ZCPG_COMMON or sub-packages",
      "no": "Continue to question 6",
      
      "question_6": "Is it an interface?",
      "yes": "Use ZCPG_INTERFACE or sub-packages",
      "no": "Consult with Technical Architect"
    }
  },
  
  "object_type_guidelines": {
    "programs": {
      "package": "Module-specific package (ZCPG_SD, ZCPG_MM, etc.)",
      "examples": [
        "ZCPG_SD_ORDER_DASHBOARD → ZCPG_SD_ORDER",
        "ZCPG_MM_BATCH_EXPIRY_RPT → ZCPG_MM_BATCH",
        "ZCPG_WM_PERFORMANCE_RPT → ZCPG_WM_PERFORMANCE"
      ]
    },
    
    "function_groups": {
      "package": "Module-specific package",
      "examples": [
        "ZCPG_SD_ORDER_UTILS → ZCPG_SD_ORDER",
        "ZCPG_MM_BATCH_UTILS → ZCPG_MM_BATCH",
        "ZCPG_COMMON_UTILS → ZCPG_COMMON_UTIL"
      ]
    },
    
    "classes": {
      "business_logic": "Module-specific package",
      "utility": "ZCPG_COMMON_UTIL",
      "exception": "Module-specific or ZCPG_COMMON",
      "interface": "Module-specific or ZCPG_COMMON",
      "examples": [
        "ZCL_CPG_SD_ORDER_PROCESSOR → ZCPG_SD_ORDER",
        "ZCL_CPG_UTIL_DATE → ZCPG_COMMON_UTIL",
        "ZCX_CPG_ORDER_ERROR → ZCPG_SD",
        "ZIF_CPG_LOGGER → ZCPG_COMMON"
      ]
    },
    
    "tables": {
      "package": "Module-specific package",
      "examples": [
        "ZCPG_ORDER_EXT → ZCPG_SD_ORDER",
        "ZCPG_BATCH_TRACK → ZCPG_MM_BATCH",
        "ZCPG_WM_CONFIG → ZCPG_WM"
      ]
    },
    
    "data_elements_domains": {
      "package": "Module-specific or ZCPG_COMMON",
      "guideline": "Use ZCPG_COMMON for reusable elements"
    }
  },
  
  "package_maintenance": {
    "creation_process": [
      {
        "step": 1,
        "activity": "Create package via SE80",
        "details": "Use naming convention ZCPG_<MODULE>_<PURPOSE>"
      },
      {
        "step": 2,
        "activity": "Set package properties",
        "details": [
          "Package type: Development",
          "Software component: HOME",
          "Transport layer: ZCPG",
          "Parent package: ZCPG or module package"
        ]
      },
      {
        "step": 3,
        "activity": "Add description",
        "details": "Clear, concise description of package purpose"
      },
      {
        "step": 4,
        "activity": "Assign responsible person",
        "details": "Module lead or team lead"
      },
      {
        "step": 5,
        "activity": "Transport package",
        "details": "Include in transport request"
      }
    ],
    
    "documentation": {
      "required": true,
      "include": [
        "Package purpose",
        "Object types contained",
        "Dependencies",
        "Responsible team",
        "Related packages"
      ]
    }
  },
  
  "transport_layer_configuration": {
    "transport_layer": "ZCPG",
    "description": "CPG Custom Developments",
    "target_system": "CPQ (Quality Assurance)",
    "consolidation_route": "CPD → CPQ",
    "delivery_route": "CPQ → CPP"
  },
  
  "package_dependencies": {
    "allowed_dependencies": [
      "SAP standard packages (read-only)",
      "Other ZCPG packages (with justification)",
      "Basis packages"
    ],
    
    "prohibited_dependencies": [
      "Customer packages from other companies",
      "Temporary packages",
      "Test packages"
    ],
    
    "dependency_management": [
      "Document all dependencies",
      "Minimize cross-module dependencies",
      "Use interfaces for loose coupling",
      "Review dependencies regularly"
    ]
  },
  
  "package_interfaces": {
    "use_when": "Exposing functionality to other packages",
    "benefits": [
      "Controlled access",
      "Encapsulation",
      "Dependency management",
      "Version control"
    ],
    "example": {
      "package": "ZCPG_SD_ORDER",
      "interface": "ZCPG_SD_ORDER_API",
      "exposed_objects": [
        "ZIF_CPG_ORDER_VALIDATOR",
        "ZCL_CPG_SD_ORDER_PROCESSOR (selected methods)"
      ]
    }
  },
  
  "package_check_rules": {
    "enable_checks": true,
    "check_types": [
      "Naming convention compliance",
      "Package assignment correctness",
      "Dependency violations",
      "Transport layer consistency"
    ],
    "enforcement": "Code Inspector variant ZCPG_PACKAGE_CHECK"
  },
  
  "migration_guidelines": {
    "existing_objects": {
      "process": [
        "Identify objects to migrate",
        "Determine correct package",
        "Create transport request",
        "Change package assignment",
        "Update documentation",
        "Test thoroughly"
      ],
      "approval_required": "Technical Architect"
    }
  },
  
  "best_practices": [
    "Keep packages focused and cohesive",
    "Use sub-packages for logical grouping",
    "Document package purpose clearly",
    "Minimize cross-package dependencies",
    "Use package interfaces for controlled access",
    "Regular package structure review",
    "Consistent naming across packages",
    "Proper transport layer assignment"
  ],
  
  "package_review": {
    "frequency": "Quarterly",
    "review_points": [
      "Package structure appropriateness",
      "Object assignment correctness",
      "Dependency management",
      "Documentation completeness",
      "Naming convention compliance"
    ],
    "responsible": "Technical Architect"
  }
}