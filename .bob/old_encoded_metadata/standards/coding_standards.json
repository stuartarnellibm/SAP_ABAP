{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SAP R/3 ABAP Coding Standards - CPG Implementation",
  "description": "Comprehensive ABAP coding standards for CPG Order-to-Cash and Warehouse Management",
  "last_updated": "2026-06-17",
  "system": "SAP R/3 ECC 6.0 On-Premise",
  
  "abap_version": {
    "minimum": "ABAP 7.40",
    "preferred": "ABAP 7.50+",
    "features_to_use": [
      "Inline declarations",
      "Constructor expressions",
      "String templates",
      "Method chaining",
      "Table expressions"
    ]
  },
  
  "code_structure": {
    "program_structure": {
      "order": [
        "1. Header comments",
        "2. Type definitions",
        "3. Data declarations (global)",
        "4. Selection screen / Parameters",
        "5. Initialization",
        "6. At selection-screen events",
        "7. Start-of-selection",
        "8. End-of-selection",
        "9. Subroutines / Methods",
        "10. Include statements (at end)"
      ],
      "example": [
        "*&---------------------------------------------------------------------*",
        "*& Report ZCPG_SD_ORDER_DASHBOARD",
        "*&---------------------------------------------------------------------*",
        "",
        "REPORT zcpg_sd_order_dashboard.",
        "",
        "* Type Definitions",
        "TYPES: BEGIN OF ty_order,",
        "         vbeln TYPE vbeln_va,",
        "         erdat TYPE erdat,",
        "       END OF ty_order.",
        "",
        "* Data Declarations",
        "DATA: gt_orders TYPE TABLE OF ty_order,",
        "      gv_count  TYPE i.",
        "",
        "* Selection Screen",
        "PARAMETERS: p_date TYPE erdat DEFAULT sy-datum.",
        "",
        "* Main Processing",
        "START-OF-SELECTION.",
        "  PERFORM get_orders.",
        "  PERFORM display_orders.",
        "",
        "* Subroutines",
        "FORM get_orders.",
        "  \" Implementation",
        "ENDFORM."
      ]
    },
    
    "class_structure": {
      "sections": [
        "1. Public section (interfaces, public methods)",
        "2. Protected section (for inheritance)",
        "3. Private section (internal implementation)"
      ],
      "method_order": [
        "1. Constructor",
        "2. Public methods (alphabetically)",
        "3. Protected methods (alphabetically)",
        "4. Private methods (alphabetically)"
      ],
      "example": [
        "CLASS zcl_cpg_sd_order_processor DEFINITION PUBLIC FINAL CREATE PUBLIC.",
        "  PUBLIC SECTION.",
        "    INTERFACES: zif_cpg_order_validator.",
        "    ",
        "    METHODS:",
        "      constructor",
        "        IMPORTING iv_order_type TYPE auart,",
        "      ",
        "      create_order",
        "        IMPORTING is_header TYPE vbak",
        "                  it_items  TYPE TABLE",
        "        EXPORTING ev_order_number TYPE vbeln_va",
        "        RAISING   zcx_cpg_order_error.",
        "  ",
        "  PROTECTED SECTION.",
        "  ",
        "  PRIVATE SECTION.",
        "    DATA: mv_order_type TYPE auart.",
        "    ",
        "    METHODS:",
        "      validate_header",
        "        IMPORTING is_header TYPE vbak",
        "        RAISING   zcx_cpg_order_error.",
        "ENDCLASS."
      ]
    }
  },
  
  "data_declarations": {
    "inline_declarations": {
      "use_when": "Variable scope is limited to single block",
      "examples": [
        "Good: DATA(lv_count) = lines( lt_orders ).",
        "Good: LOOP AT lt_orders INTO DATA(ls_order).",
        "Good: DATA(lr_processor) = NEW zcl_cpg_sd_order_processor( )."
      ]
    },
    
    "explicit_declarations": {
      "use_when": "Variable used across multiple blocks or methods",
      "examples": [
        "DATA: lv_order_number TYPE vbeln_va,",
        "      ls_order_header TYPE vbak,",
        "      lt_order_items  TYPE TABLE OF vbap."
      ]
    },
    
    "type_usage": {
      "prefer": "Use DDIC types over built-in types",
      "examples": [
        "Good: DATA lv_order TYPE vbeln_va.",
        "Bad:  DATA lv_order TYPE char10."
      ]
    },
    
    "initialization": {
      "rules": [
        "Initialize variables at declaration when possible",
        "Use CLEAR for structures and tables",
        "Use VALUE for complex initializations"
      ],
      "examples": [
        "DATA lv_status TYPE char1 VALUE 'O'.",
        "DATA ls_order TYPE vbak VALUE IS INITIAL.",
        "DATA lt_items TYPE TABLE OF vbap VALUE IS INITIAL."
      ]
    }
  },
  
  "database_access": {
    "select_statements": {
      "rules": [
        "Always specify field list (never SELECT *)",
        "Always use WHERE clause",
        "Use INTO TABLE for multiple records",
        "Use SINGLE for single record",
        "Use FOR ALL ENTRIES with INITIAL check",
        "Consider database buffering"
      ],
      "examples": {
        "good": [
          "SELECT vbeln, erdat, kunnr",
          "  FROM vbak",
          "  INTO TABLE @DATA(lt_orders)",
          "  WHERE erdat = @lv_date",
          "    AND vkorg = @lv_sales_org.",
          "",
          "SELECT SINGLE vbeln, erdat",
          "  FROM vbak",
          "  INTO @DATA(ls_order)",
          "  WHERE vbeln = @lv_order_number."
        ],
        "bad": [
          "SELECT * FROM vbak.",
          "SELECT vbeln FROM vbak."
        ]
      }
    },
    
    "for_all_entries": {
      "rules": [
        "Always check table is not initial",
        "Limit number of entries (consider splitting)",
        "Remove duplicates from driver table",
        "Use appropriate WHERE clause"
      ],
      "example": [
        "IF lt_orders IS NOT INITIAL.",
        "  SELECT vbeln, posnr, matnr",
        "    FROM vbap",
        "    INTO TABLE @DATA(lt_items)",
        "    FOR ALL ENTRIES IN @lt_orders",
        "    WHERE vbeln = @lt_orders-vbeln.",
        "ENDIF."
      ]
    },
    
    "joins": {
      "prefer": "Use INNER JOIN over nested SELECTs",
      "example": [
        "SELECT h~vbeln, h~erdat, i~posnr, i~matnr",
        "  FROM vbak AS h",
        "  INNER JOIN vbap AS i ON h~vbeln = i~vbeln",
        "  INTO TABLE @DATA(lt_result)",
        "  WHERE h~erdat = @lv_date."
      ]
    },
    
    "updates": {
      "rules": [
        "Use BAPIs for standard objects",
        "Use UPDATE for custom tables only",
        "Always check sy-subrc",
        "Use MODIFY for insert or update",
        "Consider locking (ENQUEUE/DEQUEUE)"
      ],
      "examples": [
        "MODIFY zcpg_order_ext FROM ls_order_ext.",
        "IF sy-subrc = 0.",
        "  COMMIT WORK.",
        "ELSE.",
        "  ROLLBACK WORK.",
        "  \" Error handling",
        "ENDIF."
      ]
    }
  },
  
  "control_structures": {
    "if_statements": {
      "rules": [
        "Use guard clauses to reduce nesting",
        "Prefer positive conditions",
        "Use CASE for multiple conditions on same variable",
        "Keep conditions simple and readable"
      ],
      "examples": {
        "good_guard_clause": [
          "IF lv_order_number IS INITIAL.",
          "  RETURN.",
          "ENDIF.",
          "",
          "\" Continue with main logic"
        ],
        "good_case": [
          "CASE lv_status.",
          "  WHEN 'O'.",
          "    \" Open",
          "  WHEN 'C'.",
          "    \" Closed",
          "  WHEN 'X'.",
          "    \" Cancelled",
          "  WHEN OTHERS.",
          "    \" Unknown",
          "ENDCASE."
        ],
        "bad_nested": [
          "IF condition1.",
          "  IF condition2.",
          "    IF condition3.",
          "      \" Too deeply nested",
          "    ENDIF.",
          "  ENDIF.",
          "ENDIF."
        ]
      }
    },
    
    "loops": {
      "rules": [
        "Use LOOP AT ... INTO DATA(ls_line) for inline declaration",
        "Use READ TABLE BINARY SEARCH with sorted tables",
        "Avoid nested loops where possible",
        "Use LOOP AT ... WHERE for filtering",
        "Consider REDUCE for aggregations"
      ],
      "examples": {
        "modern_loop": [
          "LOOP AT lt_orders INTO DATA(ls_order).",
          "  \" Process order",
          "ENDLOOP."
        ],
        "filtered_loop": [
          "LOOP AT lt_orders INTO DATA(ls_order)",
          "  WHERE erdat = lv_date.",
          "  \" Process filtered orders",
          "ENDLOOP."
        ],
        "read_table": [
          "SORT lt_orders BY vbeln.",
          "READ TABLE lt_orders INTO DATA(ls_order)",
          "  WITH KEY vbeln = lv_order_number",
          "  BINARY SEARCH.",
          "IF sy-subrc = 0.",
          "  \" Found",
          "ENDIF."
        ]
      }
    }
  },
  
  "error_handling": {
    "exceptions": {
      "use_in_classes": true,
      "create_custom_exceptions": true,
      "pattern": "ZCX_CPG_<error_type>",
      "example": [
        "TRY.",
        "    lo_processor->create_order(",
        "      EXPORTING",
        "        is_header = ls_header",
        "        it_items  = lt_items",
        "      IMPORTING",
        "        ev_order_number = lv_order_number ).",
        "  CATCH zcx_cpg_order_error INTO DATA(lx_error).",
        "    MESSAGE lx_error->get_text( ) TYPE 'E'.",
        "ENDTRY."
      ]
    },
    
    "sy_subrc_checks": {
      "mandatory_after": [
        "SELECT statements",
        "READ TABLE",
        "CALL FUNCTION",
        "UPDATE/MODIFY/DELETE",
        "File operations"
      ],
      "example": [
        "SELECT SINGLE * FROM vbak INTO @ls_order",
        "  WHERE vbeln = @lv_order_number.",
        "IF sy-subrc <> 0.",
        "  MESSAGE 'Order not found' TYPE 'E'.",
        "  RETURN.",
        "ENDIF."
      ]
    },
    
    "bapi_return": {
      "always_check": true,
      "example": [
        "CALL FUNCTION 'BAPI_SALESORDER_CREATEFROMDAT2'",
        "  EXPORTING",
        "    order_header_in = ls_header",
        "  IMPORTING",
        "    salesdocument   = lv_order_number",
        "  TABLES",
        "    return          = lt_return.",
        "",
        "READ TABLE lt_return INTO DATA(ls_return)",
        "  WITH KEY type = 'E'.",
        "IF sy-subrc = 0.",
        "  \" Error occurred",
        "  CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.",
        "  MESSAGE ls_return-message TYPE 'E'.",
        "ELSE.",
        "  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'",
        "    EXPORTING",
        "      wait = 'X'.",
        "ENDIF."
      ]
    }
  },
  
  "performance_guidelines": {
    "database": [
      "Minimize number of database calls",
      "Use buffering for master data",
      "Avoid SELECT in loops",
      "Use FOR ALL ENTRIES instead of nested SELECTs",
      "Use database indexes",
      "Consider database views"
    ],
    
    "internal_tables": [
      "Use appropriate table type (STANDARD, SORTED, HASHED)",
      "Use BINARY SEARCH with sorted tables",
      "Avoid nested loops",
      "Use table expressions where appropriate",
      "Clear large tables when no longer needed"
    ],
    
    "string_operations": [
      "Use string templates instead of CONCATENATE",
      "Use |text { variable }| for string formatting",
      "Avoid repeated string concatenations in loops"
    ],
    
    "examples": {
      "good": [
        "DATA(lv_message) = |Order { lv_order_number } created on { lv_date }|.",
        "",
        "DATA lt_orders TYPE SORTED TABLE OF ty_order WITH UNIQUE KEY vbeln.",
        "READ TABLE lt_orders INTO DATA(ls_order)",
        "  WITH KEY vbeln = lv_order_number BINARY SEARCH."
      ],
      "bad": [
        "CONCATENATE 'Order' lv_order_number 'created on' lv_date INTO lv_message SEPARATED BY space.",
        "",
        "DATA lt_orders TYPE STANDARD TABLE OF ty_order.",
        "READ TABLE lt_orders INTO DATA(ls_order)",
        "  WITH KEY vbeln = lv_order_number."
      ]
    }
  },
  
  "code_quality": {
    "comments": {
      "rules": [
        "Explain WHY, not WHAT",
        "Keep comments up-to-date",
        "Use meaningful comments",
        "Avoid obvious comments",
        "Document complex business logic"
      ],
      "examples": {
        "good": [
          "\" Calculate discount based on customer tier (BR-123)",
          "\" Workaround for SAP Note 1234567",
          "\" Performance optimization: use buffered read"
        ],
        "bad": [
          "\" Loop through orders",
          "\" Declare variable",
          "\" Call function"
        ]
      }
    },
    
    "magic_numbers": {
      "avoid": true,
      "use_constants": true,
      "example": [
        "Good:",
        "CONSTANTS: gc_status_open TYPE char1 VALUE 'O',",
        "           gc_max_items  TYPE i VALUE 999.",
        "",
        "IF lv_status = gc_status_open.",
        "",
        "Bad:",
        "IF lv_status = 'O'."
      ]
    },
    
    "code_duplication": {
      "avoid": true,
      "refactor_to": [
        "Subroutines",
        "Methods",
        "Function modules",
        "Utility classes"
      ]
    },
    
    "method_length": {
      "guideline": "< 50 lines per method",
      "action": "Refactor long methods into smaller ones"
    },
    
    "cyclomatic_complexity": {
      "guideline": "< 10 decision points per method",
      "action": "Simplify complex methods"
    }
  },
  
  "modern_abap_features": {
    "inline_declarations": {
      "use": true,
      "examples": [
        "DATA(lv_count) = lines( lt_orders ).",
        "LOOP AT lt_orders INTO DATA(ls_order).",
        "DATA(lr_processor) = NEW zcl_cpg_sd_order_processor( )."
      ]
    },
    
    "constructor_expressions": {
      "value": [
        "DATA(ls_order) = VALUE ty_order(",
        "  vbeln = '1234567890',",
        "  erdat = sy-datum )."
      ],
      "corresponding": [
        "DATA(ls_target) = CORRESPONDING ty_target( ls_source )."
      ],
      "new": [
        "DATA(lr_processor) = NEW zcl_cpg_sd_order_processor(",
        "  iv_order_type = 'ZORD' )."
      ]
    },
    
    "string_templates": {
      "use": true,
      "examples": [
        "DATA(lv_message) = |Order { lv_order_number } created|.",
        "DATA(lv_path) = |/tmp/{ lv_filename }.txt|."
      ]
    },
    
    "table_expressions": {
      "use": true,
      "examples": [
        "DATA(ls_order) = lt_orders[ vbeln = lv_order_number ].",
        "DATA(lv_count) = lines( lt_orders[ WHERE erdat = lv_date ] )."
      ]
    },
    
    "method_chaining": {
      "use_appropriately": true,
      "example": [
        "DATA(lv_result) = lo_processor->validate_order( ls_order )",
        "                               ->create_order( )",
        "                               ->get_order_number( )."
      ]
    }
  },
  
  "security": {
    "authorization_checks": {
      "mandatory": true,
      "example": [
        "AUTHORITY-CHECK OBJECT 'V_VBAK_VKO'",
        "  ID 'VKORG' FIELD lv_sales_org",
        "  ID 'VTWEG' FIELD lv_distribution_channel",
        "  ID 'SPART' FIELD lv_division",
        "  ID 'ACTVT' FIELD '01'.",
        "IF sy-subrc <> 0.",
        "  MESSAGE 'No authorization' TYPE 'E'.",
        "  RETURN.",
        "ENDIF."
      ]
    },
    
    "sql_injection": {
      "avoid_dynamic_sql": true,
      "use_parameters": true,
      "example": [
        "Good:",
        "SELECT * FROM vbak INTO TABLE @lt_orders",
        "  WHERE vbeln = @lv_order_number.",
        "",
        "Bad:",
        "CONCATENATE 'SELECT * FROM VBAK WHERE VBELN = ''' lv_order_number '''' INTO lv_sql.",
        "EXEC SQL.",
        "  :lv_sql",
        "ENDEXEC."
      ]
    },
    
    "sensitive_data": {
      "rules": [
        "Never log sensitive data",
        "Mask sensitive data in displays",
        "Use secure storage for credentials",
        "Follow GDPR requirements"
      ]
    }
  },
  
  "testing": {
    "unit_tests": {
      "framework": "ABAP Unit",
      "coverage_target": "80%",
      "naming": "ltcl_<class_name>",
      "structure": [
        "setup - Initialize test data",
        "test methods - One test per method",
        "teardown - Clean up"
      ],
      "example": [
        "CLASS ltcl_order_processor DEFINITION FOR TESTING",
        "  DURATION SHORT RISK LEVEL HARMLESS.",
        "  PRIVATE SECTION.",
        "    DATA: mo_cut TYPE REF TO zcl_cpg_sd_order_processor.",
        "    ",
        "    METHODS:",
        "      setup,",
        "      test_create_order FOR TESTING,",
        "      test_validate_order FOR TESTING.",
        "ENDCLASS.",
        "",
        "CLASS ltcl_order_processor IMPLEMENTATION.",
        "  METHOD setup.",
        "    mo_cut = NEW #( iv_order_type = 'ZORD' ).",
        "  ENDMETHOD.",
        "  ",
        "  METHOD test_create_order.",
        "    \" Arrange",
        "    DATA(ls_header) = VALUE vbak( vkorg = '1000' ).",
        "    ",
        "    \" Act",
        "    mo_cut->create_order(",
        "      EXPORTING is_header = ls_header",
        "      IMPORTING ev_order_number = DATA(lv_order) ).",
        "    ",
        "    \" Assert",
        "    cl_abap_unit_assert=>assert_not_initial( lv_order ).",
        "  ENDMETHOD.",
        "ENDCLASS."
      ]
    }
  },
  
  "code_review_checklist": [
    "Follows naming conventions",
    "Proper error handling",
    "Authorization checks implemented",
    "Database access optimized",
    "No code duplication",
    "Adequate comments",
    "Unit tests written",
    "Performance acceptable",
    "Security considerations addressed",
    "ABAP best practices followed"
  ]
}