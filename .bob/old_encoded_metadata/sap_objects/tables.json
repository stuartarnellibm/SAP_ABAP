{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SAP R/3 Tables Metadata - Order-to-Cash & Warehouse Management",
  "description": "Comprehensive metadata for SAP standard and custom tables used in CPG O2C and WM processes",
  "last_updated": "2026-06-17",
  "system": "SAP R/3 ECC 6.0 On-Premise",
  
  "table_categories": {
    "sales_distribution": {
      "description": "Sales & Distribution (SD) module tables",
      "tables": [
        {
          "name": "VBAK",
          "description": "Sales Document: Header Data",
          "type": "standard",
          "module": "SD",
          "modification_allowed": false,
          "read_access": "allowed",
          "write_access": "via_bapi_only",
          "key_fields": ["MANDT", "VBELN"],
          "important_fields": [
            "VBELN - Sales Document Number",
            "ERDAT - Date on which the record was created",
            "ERNAM - Name of Person who Created the Object",
            "AUART - Sales Document Type",
            "VKORG - Sales Organization",
            "VTWEG - Distribution Channel",
            "SPART - Division",
            "KUNNR - Sold-to party",
            "BSTNK - Customer purchase order number",
            "BSTDK - Customer purchase order date",
            "NETWR - Net Value of the Sales Order",
            "WAERK - SD document currency"
          ],
          "related_tables": ["VBAP", "VBUK", "VBUP"],
          "common_joins": [
            "VBAK-VBELN = VBAP-VBELN (Header to Item)",
            "VBAK-VBELN = VBUK-VBELN (Header to Status)",
            "VBAK-KUNNR = KNA1-KUNNR (Customer Master)"
          ],
          "usage_notes": "Primary table for sales order headers. Always use BAPI_SALESORDER_* for modifications.",
          "performance_notes": "Large table - use indexes on ERDAT, AUART, VKORG for better performance"
        },
        {
          "name": "VBAP",
          "description": "Sales Document: Item Data",
          "type": "standard",
          "module": "SD",
          "modification_allowed": false,
          "read_access": "allowed",
          "write_access": "via_bapi_only",
          "key_fields": ["MANDT", "VBELN", "POSNR"],
          "important_fields": [
            "VBELN - Sales Document",
            "POSNR - Sales Document Item",
            "MATNR - Material Number",
            "ARKTX - Short text for sales order item",
            "KWMENG - Cumulative Order Quantity",
            "VRKME - Sales unit",
            "NETWR - Net value of the order item",
            "WAERK - SD document currency",
            "WERKS - Plant",
            "LGORT - Storage Location",
            "PSTYV - Sales document item category",
            "ABGRU - Reason for rejection"
          ],
          "related_tables": ["VBAK", "VBUP", "LIPS"],
          "common_joins": [
            "VBAP-VBELN = VBAK-VBELN (Item to Header)",
            "VBAP-MATNR = MARA-MATNR (Material Master)",
            "VBAP-VBELN = VBUP-VBELN AND VBAP-POSNR = VBUP-POSNR (Item Status)"
          ],
          "usage_notes": "Contains line item details for sales orders. Check ABGRU for rejected items.",
          "performance_notes": "Very large table - always filter by VBELN first"
        },
        {
          "name": "VBUK",
          "description": "Sales Document: Header Status and Administrative Data",
          "type": "standard",
          "module": "SD",
          "modification_allowed": false,
          "read_access": "allowed",
          "write_access": "system_only",
          "key_fields": ["MANDT", "VBELN"],
          "important_fields": [
            "VBELN - Sales Document",
            "GBSTK - Overall Processing Status",
            "LFSTK - Delivery Status",
            "FKSTK - Billing Status",
            "ABSTK - Rejection Status",
            "UVALL - Incompletion Status",
            "CMGST - Overall Credit Status"
          ],
          "related_tables": ["VBAK", "VBUP"],
          "usage_notes": "Critical for order status monitoring. System-maintained only.",
          "performance_notes": "Small table, good performance"
        },
        {
          "name": "VBUP",
          "description": "Sales Document: Item Status",
          "type": "standard",
          "module": "SD",
          "modification_allowed": false,
          "read_access": "allowed",
          "write_access": "system_only",
          "key_fields": ["MANDT", "VBELN", "POSNR"],
          "important_fields": [
            "VBELN - Sales Document",
            "POSNR - Sales Document Item",
            "GBSTA - Overall Processing Status",
            "LFSTA - Delivery Status",
            "FKSTA - Billing Status",
            "ABSTA - Rejection Status"
          ],
          "related_tables": ["VBAP", "VBUK"],
          "usage_notes": "Item-level status information. Essential for order fulfillment tracking.",
          "performance_notes": "Large table - use with VBELN filter"
        },
        {
          "name": "LIKP",
          "description": "SD Document: Delivery Header Data",
          "type": "standard",
          "module": "LE",
          "modification_allowed": false,
          "read_access": "allowed",
          "write_access": "via_bapi_only",
          "key_fields": ["MANDT", "VBELN"],
          "important_fields": [
            "VBELN - Delivery",
            "ERDAT - Date on which the record was created",
            "LFART - Delivery Type",
            "VSTEL - Shipping Point",
            "VKORG - Sales Organization",
            "KUNNR - Ship-to party",
            "WADAT_IST - Actual Goods Movement Date",
            "LFSTK - Delivery Status",
            "WBSTK - Goods Movement Status"
          ],
          "related_tables": ["LIPS", "VBFA", "VBUK"],
          "common_joins": [
            "LIKP-VBELN = LIPS-VBELN (Header to Item)",
            "LIKP-VBELN = VBFA-VBELN (Document Flow)"
          ],
          "usage_notes": "Delivery document header. Check WBSTK for goods issue status.",
          "performance_notes": "Medium-sized table, good index on ERDAT"
        },
        {
          "name": "LIPS",
          "description": "SD Document: Delivery Item Data",
          "type": "standard",
          "module": "LE",
          "modification_allowed": false,
          "read_access": "allowed",
          "write_access": "via_bapi_only",
          "key_fields": ["MANDT", "VBELN", "POSNR"],
          "important_fields": [
            "VBELN - Delivery",
            "POSNR - Delivery Item",
            "MATNR - Material Number",
            "LFIMG - Actual quantity delivered",
            "VRKME - Sales unit",
            "LGORT - Storage Location",
            "WERKS - Plant",
            "VGBEL - Document number of the reference document",
            "VGPOS - Item number of the reference item",
            "WBSTA - Goods movement status"
          ],
          "related_tables": ["LIKP", "VBAP", "MSEG"],
          "common_joins": [
            "LIPS-VBELN = LIKP-VBELN (Item to Header)",
            "LIPS-VGBEL = VBAP-VBELN AND LIPS-VGPOS = VBAP-POSNR (Reference to Sales Order)"
          ],
          "usage_notes": "Delivery line items. VGBEL/VGPOS link back to sales order.",
          "performance_notes": "Large table - always use VBELN in WHERE clause"
        },
        {
          "name": "VBFA",
          "description": "Sales Document Flow",
          "type": "standard",
          "module": "SD",
          "modification_allowed": false,
          "read_access": "allowed",
          "write_access": "system_only",
          "key_fields": ["MANDT", "VBELV", "POSNV", "VBELN", "POSNN"],
          "important_fields": [
            "VBELV - Preceding sales and distribution document",
            "POSNV - Preceding item of an SD document",
            "VBELN - Subsequent sales and distribution document",
            "POSNN - Subsequent item of an SD document",
            "VBTYP_N - Document category of subsequent document",
            "RFMNG - Quantity"
          ],
          "related_tables": ["VBAK", "LIKP", "VBRK"],
          "usage_notes": "Critical for tracing document flow from order to delivery to invoice.",
          "performance_notes": "Very large table - use specific document numbers"
        }
      ]
    },
    
    "material_master": {
      "description": "Material Master (MM) module tables",
      "tables": [
        {
          "name": "MARA",
          "description": "General Material Data",
          "type": "standard",
          "module": "MM",
          "modification_allowed": false,
          "read_access": "allowed",
          "write_access": "via_bapi_only",
          "key_fields": ["MANDT", "MATNR"],
          "important_fields": [
            "MATNR - Material Number",
            "ERSDA - Created On",
            "ERNAM - Name of Person who Created the Object",
            "MTART - Material Type",
            "MATKL - Material Group",
            "MEINS - Base Unit of Measure",
            "MAKTX - Material Description",
            "BRGEW - Gross Weight",
            "NTGEW - Net Weight",
            "GEWEI - Weight Unit",
            "VOLUM - Volume",
            "VOLEH - Volume unit",
            "SPART - Division"
          ],
          "related_tables": ["MARC", "MARD", "MAKT"],
          "common_joins": [
            "MARA-MATNR = MARC-MATNR (Plant Data)",
            "MARA-MATNR = MARD-MATNR (Storage Location Data)",
            "MARA-MATNR = MAKT-MATNR (Material Descriptions)"
          ],
          "usage_notes": "Central material master table. Contains client-level data.",
          "performance_notes": "Large table - use MATNR or MTART indexes"
        },
        {
          "name": "MARC",
