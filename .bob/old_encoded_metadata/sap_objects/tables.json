          "modification_allowed": false,
          "read_access": "allowed",
          "write_access": "via_transaction_only",
          "key_fields": ["MANDT", "LGNUM", "LGTYP", "LGPLA"],
          "important_fields": [
            "LGNUM - Warehouse Number",
            "LGTYP - Storage Type",
            "LGPLA - Storage Bin",
            "KZLER - Indicator: Storage Bin Empty",
            "KZLER - Indicator: Storage Bin Empty",
            "PLPOS - Bin Coordinate",
            "SPGR1 - Blocking Indicator: Putaway",
            "SPGR2 - Blocking Indicator: Stock Removal"
          ],
          "related_tables": ["LQUA", "LTAP"],
          "usage_notes": "Master data for storage bins. Check blocking indicators before operations.",
          "performance_notes": "Large table - use LGNUM and LGTYP filters"
        },
        {
          "name": "LQUA",
          "description": "Quant",
          "type": "standard",
          "module": "WM",
          "modification_allowed": false,
          "read_access": "allowed",
          "write_access": "system_only",
          "key_fields": ["MANDT", "LGNUM", "LGTYP", "LGPLA", "MATNR", "CHARG", "BESTQ"],
          "important_fields": [
            "LGNUM - Warehouse Number",
            "LGTYP - Storage Type",
            "LGPLA - Storage Bin",
            "MATNR - Material Number",
            "CHARG - Batch Number",
            "BESTQ - Stock Category",
            "VERME - Available stock",
            "MEINS - Base Unit of Measure",
            "GESME - Total Stock",
            "EINME - Unit of Entry"
          ],
          "related_tables": ["LAGP", "MARD", "LTAP"],
          "common_joins": [
            "LQUA-LGNUM = LAGP-LGNUM AND LQUA-LGTYP = LAGP-LGTYP AND LQUA-LGPLA = LAGP-LGPLA (Bin Data)",
            "LQUA-MATNR = MARA-MATNR (Material Master)"
          ],
          "usage_notes": "Quant represents physical stock in a bin. VERME is available quantity.",
          "performance_notes": "Very large table - always use LGNUM and MATNR"
        },
        {
