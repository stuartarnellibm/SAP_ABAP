  "metadata_notes": {
    "modification_policy": "Standard SAP tables should never be modified directly. Use BAPIs, user exits, or enhancements.",
    "performance_guidelines": "Always use appropriate WHERE clauses with key fields. Avoid SELECT * on large tables.",
    "transport_requirements": "All custom table changes must be transported through DEV->QAS->PRD landscape.",
    "naming_conventions": "Custom tables must start with Z or Y. Use ZCPG_ prefix for CPG-specific objects."
  }
}