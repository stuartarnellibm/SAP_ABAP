          "type": "standard",
          "module": "MM",
          "modification_allowed": false,
          "read_access": "allowed",
          "write_access": "via_bapi_only",
          "key_fields": ["MANDT", "MATNR", "WERKS"],
          "important_fields": [
            "MATNR - Material Number",
            "WERKS - Plant",
            "PSTAT - Maintenance status",
            "LVORM - Flag Material for Deletion at Plant Level",
            "MMSTA - Plant-Specific Material Status",
            "DISMM - MRP Type",
            "DISPO - MRP Controller",
            "BESKZ - Procurement Type",
            "SOBSL - Special procurement type"
          ],
          "related_tables": ["MARA", "MARD"],
          "usage_notes": "Plant-specific material data. Check LVORM for deletion flag.",
          "performance_notes": "Very large table - always filter by WERKS and MATNR"
        },
        {
          "name": "MARD",
          "description": "Storage Location Data for Material",
          "type": "standard",
          "module": "MM",
          "modification_allowed": false,
          "read_access": "allowed",
          "write_access": "system_only",
          "key_fields": ["MANDT", "MATNR", "WERKS", "LGORT"],
          "important_fields": [
            "MATNR - Material Number",
            "WERKS - Plant",
            "LGORT - Storage Location",
            "LABST - Valuated Unrestricted-Use Stock",
            "INSME - Stock in Quality Inspection",
            "SPEME - Blocked Stock",
            "EINME - Unit of Entry"
          ],
          "related_tables": ["MARA", "MARC", "MSKA"],
          "usage_notes": "Storage location stock levels. Real-time stock information.",
          "performance_notes": "Extremely large table - always use all key fields"
        },
        {
          "name": "MAKT",
          "description": "Material Descriptions",
          "type": "standard",
          "module": "MM",
          "modification_allowed": false,
          "read_access": "allowed",
          "write_access": "via_bapi_only",
          "key_fields": ["MANDT", "MATNR", "SPRAS"],
          "important_fields": [
            "MATNR - Material Number",
            "SPRAS - Language Key",
            "MAKTX - Material Description"
          ],
          "related_tables": ["MARA"],
          "usage_notes": "Multi-language material descriptions.",
          "performance_notes": "Medium-sized table, good performance"
        }
      ]
    },
    
    "warehouse_management": {
      "description": "Warehouse Management (WM) module tables",
      "tables": [
        {
