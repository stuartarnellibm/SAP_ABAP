  "usage_guidelines": {
    "bapi_best_practices": [
      "Always check RETURN table for errors",
      "Call BAPI_TRANSACTION_COMMIT after successful create/change operations",
      "Use BAPI_TRANSACTION_ROLLBACK on errors",
      "Test with TESTRUN or SIMULATION flags first",
      "Use X-tables (INX) to specify which fields are being updated",
      "Never modify database tables directly - always use BAPIs"
    ],
    "error_handling": [
      "Check RETURN-TYPE for 'E' (Error), 'A' (Abort), 'W' (Warning)",
      "Log all errors for troubleshooting",
      "Implement retry logic for transient errors",
      "Use BAPI_TRANSACTION_ROLLBACK on failures"
    ],
    "performance_tips": [
      "Use batch processing for multiple documents",
      "Avoid calling BAPIs in loops - collect data first",
      "Use asynchronous processing for large volumes",
      "Consider background jobs for non-urgent operations"
    ],
    "authorization": [
      "All BAPIs respect SAP authorization objects",
      "Test with appropriate user roles",
      "Document required authorizations in specifications"
    ]
  }
