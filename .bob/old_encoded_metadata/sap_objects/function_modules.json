              "ORDER_SCHEDULES_IN - Sales Order Schedule Lines",
              "ORDER_SCHEDULES_INX - Checkbox Table for BAPI Reference Structure",
              "ORDER_CONDITIONS_IN - Sales Order Conditions",
              "ORDER_CONDITIONS_INX - Checkbox Table for BAPI Reference Structure",
              "ORDER_TEXT - Sales Order Texts",
              "RETURN - Return Messages"
            ]
          },
          "usage_example": "Create sales orders programmatically. Always check RETURN table for errors.",
          "best_practices": [
            "Always call BAPI_TRANSACTION_COMMIT after successful creation",
            "Use ORDER_HEADER_INX to specify which fields are being updated",
            "Check RETURN table for type 'E' (Error) or 'A' (Abort) messages",
            "Use TESTRUN = 'X' for validation before actual creation",
            "Populate ORDER_PARTNERS for customer assignments"
          ],
          "common_errors": [
            "Missing mandatory fields in ORDER_HEADER_IN",
            "Invalid material number in ORDER_ITEMS_IN",
            "Missing pricing conditions",
            "Incomplete partner determination"
          ],
          "related_transactions": ["VA01", "VA02", "VA03"],
          "performance_notes": "Synchronous BAPI - can be slow for large orders with many items"
