          "commit_required": true,
          "authorization_required": true,
          "key_parameters": {
            "importing": [
              "ORDER_HEADER_IN - Sales Document Header Data",
              "ORDER_HEADER_INX - Checkbox Structure for BAPI Reference Structure",
              "SENDER - Logical System",
              "BINARY_RELATIONSHIPTYPE - Checkbox for BAPI Reference Structure",
              "INT_NUMBER_ASSIGNMENT - Internal Number Assignment",
              "BEHAVE_WHEN_ERROR - Error Handling",
              "LOGIC_SWITCH - Switch Structure for BAPI",
              "TESTRUN - Test Indicator"
