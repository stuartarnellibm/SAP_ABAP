{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SAP R/3 Standard Object Modification Rules",
  "description": "Rules and guidelines for modifying SAP standard objects in CPG environment",
  "last_updated": "2026-06-17",
  "system": "SAP R/3 ECC 6.0 On-Premise",
  
  "general_principles": {
    "modification_policy": "Minimize modifications to SAP standard",
    "preferred_approach": "Use enhancement framework (User Exits, BADIs, Enhancement Spots)",
    "last_resort": "Modification with SAP Note or explicit approval",
    "documentation_required": "All modifications must be documented and justified"
  },
  
  "modification_categories": {
    "prohibited": {
      "description": "Never allowed - will break upgrade path",
      "objects": [
        {
          "object_type": "Standard Tables",
          "examples": ["VBAK", "VBAP", "LIKP", "LIPS", "MARA", "MARC"],
          "reason": "Data integrity and upgrade issues",
          "alternative": "Create Z-tables with foreign key relationships"
        },
        {
          "object_type": "Standard Function Modules",
          "examples": ["BAPI_*", "Standard FMs without user exits"],
          "reason": "Will be overwritten during upgrade",
          "alternative": "Create wrapper Z-function modules"
        },
        {
          "object_type": "Standard Classes",
          "examples": ["CL_* without enhancement spots"],
          "reason": "Object-oriented inheritance issues",
          "alternative": "Create Z-classes implementing same interfaces"
        }
      ]
    },
    
    "restricted": {
      "description": "Allowed only with explicit approval and SAP Note",
      "approval_required": ["Technical Architect", "SAP Basis Lead", "Change Manager"],
      "objects": [
        {
          "object_type": "Standard Programs",
          "examples": ["SAPMV45A", "SAPMV50A"],
          "conditions": [
            "SAP Note exists for modification",
            "No alternative enhancement available",
            "Business critical requirement",
            "Documented upgrade impact"
          ],
          "process": [
            "Search for SAP Note",
            "Document business justification",
            "Get approval from Technical Architect",
            "Create modification transport",
            "Document in modification log",
            "Test upgrade compatibility"
          ]
        },
        {
          "object_type": "Standard Includes",
          "examples": ["MV45AFZZ", "MV50AFZ1", "ZXVVAU*"],
          "conditions": [
            "Designated for customer modifications",
            "Follow SAP naming conventions",
            "Document all changes"
          ],
          "best_practices": [
            "Use only designated includes",
            "Keep modifications minimal",
            "Use modularization (forms, methods)",
            "Add comprehensive comments"
          ]
        }
      ]
    },
    
    "allowed": {
      "description": "Permitted with standard approval process",
      "objects": [
        {
          "object_type": "User Exits",
          "examples": ["USEREXIT_*", "EXIT_*"],
          "approval": "Technical Lead",
          "requirements": [
            "Document purpose and logic",
            "Unit test implementation",
            "Performance test",
            "Code review"
          ]
        },
        {
          "object_type": "BADIs",
          "examples": ["BADI_*"],
          "approval": "Technical Lead",
          "requirements": [
            "Create implementation class with Z prefix",
            "Document implementation logic",
            "Test with multiple scenarios",
            "Consider filter values"
          ]
        },
        {
          "object_type": "Enhancement Spots",
          "examples": ["Implicit and Explicit enhancements"],
          "approval": "Technical Lead",
          "requirements": [
            "Prefer explicit over implicit",
            "Document enhancement location",
            "Minimal code in enhancement",
            "Call Z-methods for complex logic"
          ]
        },
        {
          "object_type": "Append Structures",
          "examples": ["CI_* includes in standard tables"],
          "approval": "Technical Lead",
          "requirements": [
            "Use CI includes only",
            "Follow naming conventions",
            "Document field purpose",
            "Consider performance impact"
          ]
        }
      ]
    },
    
    "encouraged": {
      "description": "Preferred approaches - no special approval needed",
      "objects": [
        {
          "object_type": "Custom Z/Y Objects",
          "examples": ["Z* tables, programs, classes"],
          "requirements": [
            "Follow naming conventions",
            "Proper package assignment",
            "Standard documentation",
            "Code review"
          ]
        },
        {
          "object_type": "BAPIs",
          "examples": ["Use standard BAPIs for data manipulation"],
          "requirements": [
            "Always use BAPIs over direct table updates",
            "Check RETURN parameter",
            "Call BAPI_TRANSACTION_COMMIT",
            "Handle errors properly"
          ]
        }
      ]
    }
  },
  
  "specific_object_rules": {
    "sales_distribution": {
      "module": "SD",
      "objects": [
        {
          "object": "SAPMV45A (Sales Order Processing)",
          "modification_allowed": false,
          "alternatives": [
            "User exits in MV45AFZZ",
            "BADI_SD_SALES_HEADER_CHECK",
            "BADI_SD_SALES_ITEM_CHECK",
            "Enhancement spots in ES_SAPLV45A"
          ],
          "common_requirements": [
            "Custom validations → Use BADIs",
            "Additional fields → Use CI includes",
            "Custom pricing → Use USEREXIT_PRICING_*",
            "Document flow → Use VBFA table"
          ]
        },
        {
          "object": "VBAK/VBAP (Sales Order Tables)",
          "modification_allowed": false,
          "alternatives": [
            "Create ZCPG_ORDER_EXT table with VBELN as key",
            "Use CI_VBAK_APPEND for header fields",
            "Use CI_VBAP_APPEND for item fields"
          ],
          "best_practices": [
            "Never add fields directly to standard tables",
            "Use foreign key relationships",
            "Maintain data consistency",
            "Document field usage"
          ]
        }
      ]
    },
    
    "logistics_execution": {
      "module": "LE",
      "objects": [
        {
          "object": "SAPMV50A (Delivery Processing)",
          "modification_allowed": false,
          "alternatives": [
            "User exits in MV50AFZ1",
            "BADI_LE_SHIPMENT_PUBLISH",
            "Enhancement spots"
          ]
        },
        {
          "object": "LIKP/LIPS (Delivery Tables)",
          "modification_allowed": false,
          "alternatives": [
            "Create ZCPG_DELIVERY_EXT table",
            "Use CI includes if available"
          ]
        }
      ]
    },
    
    "warehouse_management": {
      "module": "WM",
      "objects": [
        {
          "object": "SAPLL03T (Transfer Order Processing)",
          "modification_allowed": false,
          "alternatives": [
            "EXIT_SAPLL03T_001 for storage determination",
            "EXIT_SAPLL03T_002 for confirmation",
            "BADI_WM_PICKING_STRATEGY",
            "BADI_WM_PUTAWAY_STRATEGY"
          ]
        },
        {
          "object": "LTAK/LTAP (Transfer Order Tables)",
          "modification_allowed": false,
          "alternatives": [
            "Create ZCPG_TO_EXT table",
            "Use user exits for custom logic"
          ]
        }
      ]
    },
    
    "material_management": {
      "module": "MM",
      "objects": [
        {
          "object": "MARA/MARC/MARD (Material Master)",
          "modification_allowed": false,
          "alternatives": [
            "Create ZCPG_MATERIAL_EXT table",
            "Use BADI_MATERIAL_CHECK for validations",
            "Use CI includes for additional fields"
          ]
        }
      ]
    }
  },
  
  "modification_process": {
    "step_1_analysis": {
      "activities": [
        "Identify business requirement",
        "Search for SAP standard solution",
        "Check for SAP Notes",
        "Evaluate enhancement options",
        "Document findings"
      ],
      "deliverable": "Analysis document with recommendation"
    },
    
    "step_2_design": {
      "activities": [
        "Design solution using preferred approach",
        "Document technical design",
        "Identify impacted objects",
        "Plan testing approach",
        "Assess upgrade impact"
      ],
      "deliverable": "Technical design document"
    },
    
    "step_3_approval": {
      "activities": [
        "Submit for technical review",
        "Get approval based on modification category",
        "Document approval in change request"
      ],
      "approvers": {
        "prohibited": "Not allowed",
        "restricted": ["Technical Architect", "SAP Basis Lead", "Change Manager"],
        "allowed": ["Technical Lead"],
        "encouraged": ["Peer review only"]
      }
    },
    
    "step_4_implementation": {
      "activities": [
        "Create transport request",
        "Implement solution",
        "Add comprehensive comments",
        "Unit test",
        "Code review",
        "Integration test"
      ],
      "deliverable": "Tested code in transport"
    },
    
    "step_5_documentation": {
      "required_documents": [
        "Modification log entry",
        "Technical specification",
        "Test results",
        "Upgrade impact assessment",
        "Rollback procedure"
      ]
    }
  },
  
  "modification_log": {
    "purpose": "Track all modifications to SAP standard",
    "location": "ZCPG_MODIFICATION_LOG table",
    "required_fields": [
      "Modification ID",
      "Object type and name",
      "Modification type",
      "Business justification",
      "SAP Note reference (if applicable)",
      "Transport request",
      "Developer",
      "Approval date and approver",
      "Upgrade impact",
      "Test results reference"
    ],
    "maintenance": "Updated for every modification",
    "review_frequency": "Quarterly review by Technical Architect"
  },
  
  "upgrade_considerations": {
    "pre_upgrade_activities": [
      "Review modification log",
      "Check SAP Notes for conflicts",
      "Test modifications in sandbox",
      "Document required rework",
      "Plan modification reapplication"
    ],
    "during_upgrade": [
      "Monitor modification overwrites",
      "Document conflicts",
      "Reapply modifications as needed"
    ],
    "post_upgrade": [
      "Test all modifications",
      "Update modification log",
      "Document lessons learned"
    ]
  },
  
  "code_inspector_checks": {
    "mandatory_checks": [
      "No direct table modifications",
      "No modifications to standard FMs",
      "Proper use of enhancement framework",
      "Performance standards met",
      "Security vulnerabilities"
    ],
    "custom_check_variant": "ZCPG_MOD_CHECK",
    "run_frequency": "Before transport release"
  },
  
  "exceptions_and_waivers": {
    "process": [
      "Document business criticality",
      "Prove no alternative exists",
      "Get executive approval",
      "Document in modification log",
      "Plan for future remediation"
    ],
    "approval_authority": "IT Director + Business Owner",
    "review_frequency": "Annual review of all exceptions"
  },
  
  "best_practices": [
    "Always search for SAP standard solution first",
    "Use enhancement framework over modifications",
    "Create Z-objects for custom logic",
    "Document all changes comprehensively",
    "Test upgrade compatibility",
    "Keep modifications minimal and focused",
    "Use modular design for maintainability",
    "Follow naming conventions strictly",
    "Implement proper error handling",
    "Consider performance impact"
  ],
  
  "training_requirements": {
    "developers": [
      "Enhancement framework training",
      "BADI implementation",
      "User exit usage",
      "Modification impact assessment"
    ],
    "architects": [
      "Upgrade impact analysis",
      "Alternative solution design",
      "SAP Note research"
    ]
  }
}